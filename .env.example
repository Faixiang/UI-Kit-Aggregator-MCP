# Copy to .env if you want local tokens. Never commit .env.
# Empty values are treated as unset. Paid source is fetched only from the
# official registry, is not cached, and is not written to disk.

# Aceternity All-Access API key. Sent only as
# Authorization: Bearer <token> to https://ui.aceternity.com/registry/{name}.json
# Documented on https://ui.aceternity.com/installation
# ACETERNITY_PRO_TOKEN=

# React Bits Pro license key. The installation page names this variable
# REACTBITS_LICENSE_KEY (not a guessed alias). Sent only as
# Authorization: Bearer <key> to
# https://pro.reactbits.dev/api/r/starter/{name}.json or
# https://pro.reactbits.dev/api/r/pro/{name}.json
# Do not run the HTTP transport on a public host with this key set.
# REACTBITS_LICENSE_KEY=

# Optional. Enables GitHub code search inside uiverse-io/galaxy so queries
# can match tags in HTML comments. Without it, search uses category folders
# and file paths from the public git tree.
# GITHUB_TOKEN=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Used only when MCP_TRANSPORT=http or you pass --http. Binds to loopback.
# HOST=127.0.0.1
# PORT=3847

# In-memory catalog TTL. Paid registry responses are never cached.
# CATALOG_CACHE_TTL_MS=600000
